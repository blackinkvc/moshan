#!/bin/bash
# 推送闸门 v3（2026-11-24 17:0x）
#
# 背景：这个仓库会被**多个 WorkBuddy 窗口并行改**，它们共用同一份工作目录。
# AI 窗口比人危险的地方在于 —— push 被拒时它会自己 fetch / 强推 / reset --hard
# 「保留我的版本」，别人的提交就没了，而且全程不报错。所以闸门不只拦「谁推」，
# 还要拦「怎么推」：
#
#   1) 非快进 / 强推（含 --force、--force-with-lease、改已有 tag）→ 一律拒
#   2) 删除分支或 tag                                              → 一律拒
#   3) 推 main / master / 非 agent 分支                            → 拒（要 MOSHAN_PUSH=workbuddy）
#   4) 推 agent/*                                                  → 放行（并行窗口的正常出口）
#
# 逃生口只有一个，必须同时给两个变量，且会在日志里留痕：
#   MOSHAN_PUSH=workbuddy MOSHAN_FORCE=1 git push ...
# 注意：main 现在还上了 GitHub Ruleset（要求 PR），带令牌直推也会被服务端拒 —— 
# 钩子这层只是给出更早、更说人话的报错。
#
# 每次尝试都记 $HOME/Documents/cuntu/push-guard.log。
LOG="${HOME}/Documents/cuntu/push-guard.log"
ZERO=0000000000000000000000000000000000000000

OWNER=other
[ "${MOSHAN_PUSH:-}" = "workbuddy" ] && OWNER=workbuddy
FORCE_OK=0
if [ "${MOSHAN_FORCE:-}" = "1" ] && [ "${OWNER}" = "workbuddy" ]; then
  FORCE_OK=1
fi

BAD=""      # 不该由这个来源推的引用
FORCED=""   # 非快进 / 删除
N=0

while read -r LREF LSHA RREF RSHA; do
  [ -z "${RREF}" ] && continue
  N=$((N + 1))

  # 删除远端引用：本地 sha 全 0
  if [ "${LSHA}" = "${ZERO}" ]; then
    case "${RREF}" in
      refs/heads/agent/*|refs/heads/workbuddy/*) ;;
      *) FORCED="${FORCED} 删除${RREF}" ;;
    esac
    continue
  fi

  # 非快进 = 强推。远端 sha 全 0 是新建分支，不算。
  # 远端对象本地没有（浅克隆/没 fetch）时不判，交给服务端。
  if [ "${RSHA}" != "${ZERO}" ]; then
    if git cat-file -e "${RSHA}^{commit}" 2>/dev/null; then
      if ! git merge-base --is-ancestor "${RSHA}" "${LSHA}" 2>/dev/null; then
        FORCED="${FORCED} ${RREF}(非快进)"
      fi
    fi
  fi

  case "${RREF}" in
    refs/heads/agent/*|refs/heads/workbuddy/*) ;;
    refs/heads/main|refs/heads/master) BAD="${BAD} main" ;;
    refs/tags/*) BAD="${BAD} tag" ;;
    refs/heads/*) BAD="${BAD} ${RREF}" ;;
    *) ;;
  esac
done

{
  printf '%s | %s | %s | refs=%s | bad=%s | forced=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "${OWNER}" "${1:-?}" "${N}" \
    "${BAD:-无}" "${FORCED:-无}"
} >>"${LOG}" 2>/dev/null

if [ -n "${FORCED}" ] && [ "${FORCE_OK}" != "1" ]; then
  {
    echo ""
    echo "[推送闸门] 拦下非快进操作：${FORCED}"
    echo "           这个仓库有多个窗口并行写，强推/删除会抹掉别人已推的提交。"
    echo "           正确做法：git fetch origin && git rebase origin/main 后重推。"
    echo "           确需强推（仅自己能确认没别人在写）才用："
    echo "           MOSHAN_PUSH=workbuddy MOSHAN_FORCE=1 git push <远端> <分支>"
    echo "           本次尝试已记入 ${LOG}"
    echo ""
  } >&2
  exit 1
fi

if [ "${OWNER}" != "workbuddy" ] && [ -n "${BAD}" ]; then
  {
    echo ""
    echo "[推送闸门] main / tag 的推送由 WorkBuddy 窗口执行，已拦下：${BAD}"
    echo "           并行任务请推自己的分支，别动 main："
    echo "           git push origin HEAD:refs/heads/agent/<你的名字>"
    echo "           要手工推 main 得带令牌：MOSHAN_PUSH=workbuddy git push origin main"
    echo "           （main 已上 GitHub Ruleset，要求走 PR，直推会被服务端再拒一次）"
    echo "           打 tag 会触发自动构建并发布 Release，别顺手推 tag。"
    echo "           本次尝试已记入 ${LOG}"
    echo ""
  } >&2
  exit 1
fi

[ -n "${FORCED}" ] && {
  printf '%s | 警告：带着 FORCE 逃生口放行了 forced=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "${FORCED}" >>"${LOG}" 2>/dev/null
}
exit 0
