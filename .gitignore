# 构建与本地环境
.venv/
.venv-build/
__pycache__/
*.pyc
*.pyo
build/
dist/
*.egg-info/

# 产物
*.dmg
*.exe
*.msi
*.zip

# 运行时数据（绝不提交）
config.json
*.log
*.jsonl
certs/
shares.json
welcome.done

# 同步机制的本地产物（scripts/sync-from-dev.sh）
.sync-baseline/
.sync-conflicts/

# 系统垃圾
.DS_Store
# 仓库放在 exFAT / 网络盘上时 macOS 会生成 AppleDouble（._xxx）元数据文件，
# 它们是二进制、含 null 字节，compileall 与 grep 都会被它们绊到。
._*
.pytest_cache/
._*
Thumbs.db
desktop.ini

# 发版时由 CI 生成（.github/workflows/build.yml）
notes.md

# 可选的 openssl 二进制（vendor/openssl/openssl.exe + dll）：谁要谁放，不入库
vendor/openssl/

# Tauri 桌面壳（src-tauri/）
# target/ 是 cargo 产物（几 GB 到几十 GB）；gen/ 是 tauri-build 每次现生成的能力 schema。
# sidecar 二进制同样不入库，见 src-tauri/binaries/README.md。
src-tauri/target/
src-tauri/gen/
src-tauri/.cargo/
src-tauri/binaries/moshan-*


# Rust 服务（rust/）：迁移期产物
rust/target/
rust/Cargo.lock.bak
